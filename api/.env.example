# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4-compatible,
# which Render needs). Looks like:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port the HTTP server listens on. Render sets this automatically; 3000 is used locally if unset.
PORT=3000
